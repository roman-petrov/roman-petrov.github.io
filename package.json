{
  "name": "resume",
  "version": "1.0.0",
  "private": true,
  "description": "Roman Petrov resume (HTML/CSS → PDF)",
  "type": "module",
  "scripts": {
    "pdf": "node scripts/print-pdf.mjs",
    "preview": "npx --yes serve src -l 4173",
    "format": "prettier --write .",
    "lint:md": "markdownlint-cli2",
    "spell": "cspell \"**/*.{md,html,css,js,mjs,json,jsonc}\"",
    "check": "prettier --check . && npm run lint:md && npm run spell"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "^2.3.2",
    "cspell": "^9.2.0",
    "markdownlint-cli2": "^0.18.1",
    "prettier": "^3.6.2",
    "puppeteer": "^24.22.0"
  }
}
