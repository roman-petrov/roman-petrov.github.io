{
  "name": "resume",
  "version": "1.0.0",
  "type": "module",
  "description": "Roman Petrov resume (HTML/CSS → PDF)",
  "private": true,
  "scripts": {
    "build": "bun scripts/Build.ts",
    "ci": "bun run test && bun run lint && bun run build",
    "cspell": "cspell .",
    "eslint": "eslint --max-warnings=0 .",
    "eslint-fix": "eslint --fix --max-warnings=0 .",
    "jscpd": "jscpd",
    "knip": "knip",
    "lint": "bun run tsc && bun run eslint && bun run prettier && bun run stylelint && bun run cspell && bun run knip && bun run markdownlint && bun run jscpd",
    "markdownlint": "markdownlint .",
    "pdf": "bun scripts/Pdf.ts",
    "prettier": "prettier --check .",
    "prettier-fix": "prettier --write .",
    "preview": "bun run build && bunx --bun serve dist -l 4173",
    "stylelint": "stylelint --max-warnings=0 \"**/*.scss\"",
    "stylelint-fix": "stylelint --fix --max-warnings=0 \"**/*.scss\"",
    "test": "vitest run",
    "tsc": "tsc --noEmit"
  },
  "devDependencies": {
    "@cspell/dict-ru_ru": "^2.3.2",
    "@eslint/js": "^9",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/eslint-plugin": "^1.6.26",
    "actions-up": "^1.16.0",
    "cspell": "^9.2.0",
    "eslint": "^9",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-perfectionist": "^5.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unicorn": "^72.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "github-slugger": "^2.0.0",
    "jscpd": "^5.0.14",
    "knip": "^6.31.0",
    "markdownlint-cli": "^0.45.0",
    "prettier": "^3.6.2",
    "prettier-plugin-pkg": "^0.21.0",
    "puppeteer": "^24.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass-embedded": "^1.100.0",
    "stylelint": "^17",
    "stylelint-config-recess-order": "^7.7.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8",
    "typescript": "^6",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-sass-dts": "^1.3.37",
    "vitest": "^4.1.10"
  }
}
