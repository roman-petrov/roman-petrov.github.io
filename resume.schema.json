{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "activities": {
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "to": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "references": {
                "type": "object",
                "properties": {
                  "label": { "type": "string" },
                  "links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "label": { "type": "string" },
                        "url": { "type": "string", "format": "uri" },
                        "note": { "type": "string" }
                      },
                      "required": ["url", "note"],
                      "additionalProperties": false
                    }
                  }
                },
                "required": ["label", "links"],
                "additionalProperties": false
              },
              "summary": { "type": "string" },
              "title": { "type": "string" }
            },
            "required": ["from", "to", "summary", "title"],
            "additionalProperties": false
          }
        }
      },
      "required": ["icon", "title", "items"],
      "additionalProperties": false
    },
    "contacts": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "github": { "type": "string" },
        "location": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["email", "github", "location", "phone"],
      "additionalProperties": false
    },
    "education": {
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "studies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "to": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "degree": { "type": "string" },
              "place": { "type": "string" },
              "school": { "type": "string" }
            },
            "required": ["from", "to", "degree", "place", "school"],
            "additionalProperties": false
          }
        }
      },
      "required": ["icon", "title", "studies"],
      "additionalProperties": false
    },
    "experience": {
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "jobs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "to": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
              "company": { "type": "string" },
              "duties": { "type": "array", "items": { "type": "string" } },
              "projects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "link": {
                      "type": "object",
                      "properties": { "label": { "type": "string" }, "url": { "type": "string", "format": "uri" } },
                      "required": ["url"],
                      "additionalProperties": false
                    },
                    "name": { "type": "string" },
                    "note": { "type": "string" },
                    "roles": { "type": "array", "items": { "type": "string" } },
                    "stack": { "type": "array", "items": { "type": "string" } },
                    "url": { "type": "string", "format": "uri" }
                  },
                  "required": ["name", "roles", "stack"],
                  "additionalProperties": false
                }
              },
              "role": { "type": "string" },
              "summary": { "type": "string" },
              "url": { "type": "string", "format": "uri" }
            },
            "required": ["from", "to", "company", "projects", "role"],
            "additionalProperties": false
          }
        }
      },
      "required": ["icon", "title", "jobs"],
      "additionalProperties": false
    },
    "meta": {
      "type": "object",
      "properties": {
        "github": { "type": "string", "format": "uri" },
        "name": { "type": "string" },
        "pdf": { "type": "string" },
        "photo": { "type": "string" },
        "role": { "type": "string" },
        "site": { "type": "string", "format": "uri" },
        "tagline": { "type": "string" }
      },
      "required": ["github", "name", "pdf", "photo", "role", "site", "tagline"],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "approach": { "type": "string" },
        "motto": { "type": "string" },
        "proficiency": {
          "type": "object",
          "properties": {
            "areas": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": { "area": { "type": "string" }, "detail": { "type": "string" } },
                "required": ["area", "detail"],
                "additionalProperties": false
              }
            },
            "lead": { "type": "string" }
          },
          "required": ["areas", "lead"],
          "additionalProperties": false
        },
        "wishes": {
          "type": "object",
          "properties": { "items": { "type": "array", "items": { "type": "string" } }, "lead": { "type": "string" } },
          "required": ["items", "lead"],
          "additionalProperties": false
        }
      },
      "required": ["icon", "title", "approach", "motto", "proficiency", "wishes"],
      "additionalProperties": false
    },
    "stack": {
      "type": "object",
      "properties": {
        "icon": { "type": "string" },
        "title": { "type": "string" },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "icon": { "type": "string" },
              "items": { "type": "array", "items": { "type": "string" } },
              "label": { "type": "string" }
            },
            "required": ["icon", "items", "label"],
            "additionalProperties": false
          }
        },
        "skills": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["icon", "title", "facts", "skills"],
      "additionalProperties": false
    }
  },
  "required": ["activities", "contacts", "education", "experience", "meta", "profile", "stack"],
  "additionalProperties": false
}
